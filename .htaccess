# --- Mes Cours : configuration Apache -------------------------------------

Options -Indexes
DirectoryIndex index.php

# Toutes les URL inconnues passent par le contrôleur frontal.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Les dossiers internes ne sont jamais servis directement. « outils » porte des scripts faits
# pour la ligne de commande — certains lisent et effacent des comptes d'essai en base : une
# adresse ne doit pas pouvoir les lancer.
# « (/.*)? » : le dossier de l'application peut être à la racine du domaine (« /src/… ») comme
# dans un sous-dossier (« /mes-cours/src/… »). Sans cela, seul le second était protégé.
RedirectMatch 404 (?i)^(/.*)?/(config|src|controllers|views|storage|sql|outils)/

# Le dépôt git n'est pas à servir : il contient tout le code et son historique.
RedirectMatch 404 (?i)/\.git(/|ignore|attributes|$)

# Taille des fichiers téléversés.
# Le nom du module est « php_module » avec Apache 2.4 + PHP 8 : un garde
# « mod_php.c » ne correspond à rien et les directives seraient ignorées.
# Ces valeurs ne servent que de repli : la référence est le php.ini de WAMP.
<IfModule php_module>
    php_value upload_max_filesize 200M
    php_value post_max_size 256M
    php_value max_file_uploads 20
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

# Cache des ressources statiques.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
